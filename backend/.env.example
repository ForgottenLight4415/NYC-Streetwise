# Copy to .env and fill in. .env is gitignored.

# Socrata app token for data.cityofnewyork.us. Requests work without one but
# throttle hard under load, so register one before the demo.
# https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Origins allowed to read responses from a browser (comma-separated; see
# src/app.js). Defaults to http://localhost:3000 when unset — correct for the
# frontend's local dev server, so this is not needed locally. Deployed value
# lives in .env.production.example.
# ALLOWED_ORIGIN=http://localhost:3000

# --- MongoDB: two environments, one variable --------------------------------
# Dev  -> Mongo in Docker locally (`docker compose up`)
# Prod -> MongoDB Atlas, values set in the deploy host's env settings
# Nothing in the code branches on environment; only this value changes. Prod
# values live in .env.production.example, never in a committed .env.
#
# Optional either way — Mongo backs the complaint cache and nothing else.
# Without it the app still works; every lookup just goes straight to Socrata
# (slower, and throttled harder).
#
# This file is the DEV default. compose.yaml overrides it to mongodb://mongo:27017
# for the container; the loopback form below is what the API uses when you run it
# natively on the host against that same container.
MONGODB_URI=mongodb://127.0.0.1:27017

# Which database inside the cluster. Keep dev and prod on different names — an
# SRV URI carries no database name, so this is the only thing separating them.
# Defaults to should_i_live_here when unset.
MONGODB_DB=nyc-streetwise-dev

# Both default to sane values; raise the timeout if an Atlas cluster is slow to
# elect a primary (cold M0 clusters can be), and the pool size only if you are
# actually saturating it.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
# MONGO_MAX_POOL_SIZE=10

PORT=3001

# --- AI explanation layer ----------------------------------------------------
# Entirely optional. With no provider configured every explanation falls back to
# a deterministic template and no endpoint changes behaviour or fails.

# "ollama" (local dev) or "gemini" (deployed). Defaults to ollama.
AI_PROVIDER=ollama

# Ollama: needs `ollama serve` running and the model pulled.
#   ollama pull llama3.1:8b
# CLAUDE.md specifies "llama3"; llama3.1:8b is the default because that is what
# was pulled on the dev machine. Either works — it is one variable.
OLLAMA_MODEL=llama3.1:8b
# Defaults to http://localhost:11434/api/generate. compose.yaml overrides this
# to host.docker.internal so a container can reach a host Ollama — see
# README.md.
# OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# Gemini: set in the Vercel dashboard for deployment, NEVER commit a real key.
GEMINI_API_KEY=
# Default is gemini-3.5-flash-lite. NOTE: CLAUDE.md's gemini-2.5-flash-lite now
# returns 404 "no longer available to new users" — see documentation/m6.
GEMINI_MODEL=gemini-3.5-flash-lite
# Only needed for gemini-2.5-* models, which otherwise spend the whole output
# budget on thinking tokens and return a truncated fragment. Leave unset for 3.x.
# GEMINI_THINKING_BUDGET=0
