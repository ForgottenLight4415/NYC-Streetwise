{
  "name": "should-i-live-here-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NYC 311 address risk scoring API (Building Health + Block Quality)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline": "node --env-file-if-exists=.env scripts/buildBaseline.js",
    "warm:showcase": "node --env-file-if-exists=.env scripts/warmShowcase.js",
    "verify:dataset": "node --env-file-if-exists=.env scripts/verifyDataset.js",
    "verify:amenities": "node --env-file-if-exists=.env scripts/verifyAmenities.js",
    "build:amenities": "node --env-file-if-exists=.env scripts/buildAmenities.js",
    "baseline:amenities": "node --env-file-if-exists=.env scripts/buildAmenityBaseline.js",
    "verify:cache": "node --env-file-if-exists=.env scripts/verifyCache.js",
    "verify:scoring": "node --env-file-if-exists=.env scripts/verifyScoring.js",
    "verify:explanations": "node --env-file-if-exists=.env scripts/verifyExplanations.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "vitest": "^3.2.4"
  }
}
