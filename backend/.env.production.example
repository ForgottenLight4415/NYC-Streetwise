# Production environment — MongoDB Atlas.
#
# This is a REFERENCE, not a file the app loads. `npm start` reads .env only, and
# .env files do not deploy. Paste these into the deploy host's environment
# settings (Vercel > Project Settings > Environment Variables, or equivalent).
#
# The dev/prod split is entirely in these values. No code branches on
# environment: src/providers/mongo.js reads MONGODB_URI and MONGODB_DB and does
# not care whether it got a local mongod or an Atlas cluster.

# --- Mongo (Atlas) -----------------------------------------------------------
# From Atlas > Connect > Drivers > Node.js. Replace <db_password> with the real
# password for the `forgottenlight` database user (Atlas > Database Access), and
# percent-encode it if it contains @ : / ? # [ ] or %.
#
# An unreplaced <db_password> is detected at startup: the app logs a warning and
# runs uncached rather than throwing a parse error on every request. So a
# forgotten password degrades the deploy, it does not break it — but it also
# will not announce itself as loudly as a crash would. Check the boot logs.
MONGODB_URI=mongodb+srv://forgottenlight:<db_password>@nyc-streetwise.7aqt3oz.mongodb.net/?retryWrites=true&w=majority&appName=nyc-streetwise

# Deliberately different from dev's nyc-streetwise-dev.
MONGODB_DB=nyc-streetwise

# Atlas checklist before the first deploy:
#   - Database Access: a user with readWrite on this database
#   - Network Access: allow the deploy's egress IPs. Serverless platforms do not
#     publish a stable IP range, so this is usually 0.0.0.0/0 — which makes the
#     database password the only thing protecting the cluster. Rotate it if it
#     is ever pasted anywhere shared.
#   - M0 free tier caps a cluster at 500 connections; mongo.js keeps a pool of
#     10 and caches the client on globalThis so reused instances do not stack
#     pools. Raise MONGO_MAX_POOL_SIZE only if you measure saturation.

# --- Everything else ---------------------------------------------------------
SOCRATA_APP_TOKEN=
# Ollama cannot run on serverless — the deployed AI provider must be gemini.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of origins allowed to read responses from a browser
# (see src/app.js). Unset defaults to http://localhost:3000 only, which is
# NOT the deployed frontend's origin, so this must be set explicitly or the
# deployed frontend's fetch calls will fail CORS.
ALLOWED_ORIGIN=https://your-frontend-project.vercel.app
