# Copy to .env.local and fill in. .env.local is gitignored.
#
# TWO Google Maps keys, not one. They are restricted differently in the Google
# Cloud console and are not interchangeable — see frontend/lib/maps-keys.ts.

# --- Site URL -----------------------------------------------------------------
# This app's own deployed origin (not the backend's). Read only by
# lib/site-url.ts, used to build absolute URLs in app/robots.ts and
# app/sitemap.ts. Defaults to http://localhost:3000 when unset. Public by
# design — it's the URL search engines already see — so it needs the
# NEXT_PUBLIC_ prefix. No trailing slash needed; one is stripped if present.
NEXT_PUBLIC_SITE_URL=

# --- Server key: never leaves the server ------------------------------------
# Used by app/api/geocode and app/api/autocomplete (Node-side fetches).
# Enable on the Google Cloud project:
#   - Geocoding API
#   - Places API (New)
# Restrict by: IP address (your dev machine / the deploy's egress IPs).
# Billed per request, and page source never contains it. Without it, geocoding
# returns 500 and autocomplete silently falls back to lib/mock-data.ts.
GOOGLE_MAPS_API_KEY=

# --- Client key: published in page source ------------------------------------
# Injected into the <script src> tag by app/report and app/compare, so anyone can read it.
# That is expected for the Maps JavaScript API — restrict it, don't hide it.
# Enable on the Google Cloud project:
#   - Maps JavaScript API
#   - Advanced Markers (Map ID / marker library)
# Restrict by: HTTP referrer (http://localhost:3000/*, your deployed domain/*).
# Without it, MapPanel renders a config-needed message; everything else works.
GOOGLE_MAPS_CLIENT_KEY=

# --- Map ID: cloud-based map style -------------------------------------------
# Created in Map Management in the Google Cloud console (Google Maps Platform
# > Map Management > Create Map ID, rendering type Vector). Required for
# Advanced Markers and lets a style be attached in the console instead of an
# inline `styles` array (the Maps JS API rejects `styles` when `mapId` is set).
# Public by design — read in the browser, so it needs the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Backend base URL ---------------------------------------------------------
# The separately-deployed Express backend (score/complaints/explanation calls
# in lib/api.ts). Same-origin routes above (geocode, autocomplete) don't need
# this. Defaults to http://localhost:3001 when unset, which is correct for
# local dev against `npm run dev` in /backend. Public by design — the browser
# calls this directly — so it needs the NEXT_PUBLIC_ prefix.
# Deployed: set to the backend's Vercel URL, e.g. https://nyc-streetwise-api.vercel.app
NEXT_PUBLIC_API_BASE_URL=

# --- Internal API secret ------------------------------------------------------
# Shared with the backend. Used ONLY on the server, by app/api/geocode/route.ts,
# to record a resolved address against the backend's lookup directory.
#
# Deliberately NOT prefixed NEXT_PUBLIC_. Anything with that prefix is inlined
# into the client bundle at build time, which would publish this credential to
# every visitor and defeat the point of having it: the endpoint it protects is
# what keeps browser-supplied text off the homepage.
#
# Must match backend/.env's INTERNAL_API_SECRET exactly. Unset, the app works
# normally and simply records no lookups.
INTERNAL_API_SECRET=
